PORT=3036
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3036
# Unset DATABASE_URL for local SQLite. AWS: PostgreSQL on RDS.
# DATABASE_URL=postgresql://bellama:password@localhost:5433/bellama
ENABLE_DEMO=true
# 운영 모드(npm start)에서는 이 값과 상관없이 데모 계정·테스트 결제가 꺼지고, HTTPS APP_ORIGIN·DATABASE_URL이 필수입니다.
ANDROID_STORE_URL=
IOS_STORE_URL=
# 로드밸런서(ALB)·Cloudflare 등 프록시 뒤에서 실행할 때 프록시 단계 수(보통 1).
# 비워 두면 모든 요청이 프록시 IP 하나로 보여 요청 제한(분당 240회)이 전체 사용자 공용이 됩니다.
# TRUST_PROXY_HOPS=1
# 계좌번호·AI API 키·발송 비밀값 암호화 키(32자 이상). 운영에서는 필수(없으면 서버가 시작하지 않음).
# 개발에서는 비워 두면 data/.ai-secret 파일을 자동으로 만들어 씁니다.
# AI_SECRET_KEY=
# 데이터 폴더(개발 SQLite·암호 키 파일)와 업로드 폴더. 웹 서버와 합성 worker는 같은 값을 써야 합니다.
# DATA_DIR=data
# UPLOAD_DIR=uploads/bellama
# 회차·예고편 합성을 별도 작업 프로세스(npm run worker)로 돌릴 때 external. 동시 합성 수.
# COMPOSE_WORKER=external
# COMPOSE_CONCURRENCY=1
# ffmpeg 실행 파일 경로(운영 Docker 이미지는 시스템 ffmpeg 사용, 개발은 ffmpeg-static 자동 사용)
# FFMPEG_PATH=
# 썸네일 A/B 비교: 승자를 정하기 전 후보별 최소 노출 수(기본 300)
# AB_MIN_IMPRESSIONS=
# 개발용: Cloudflare 터널(외부 미리보기)에서도 관리자 데모 로그인을 허용(기본은 거절)
# ALLOW_TUNNEL_ADMIN_DEMO=true
# 개발용 가짜 AI 응답 지연(ms)
# AI_MOCK_DELAY_MS=0
# 모바일 앱(토큰 로그인): 앱을 빌드할 때 운영 서버 주소를 넣어요(예: VITE_API_ORIGIN=https://your-bellama-domain.example npm run mobile:sync).
# VITE_API_ORIGIN=
# 앱 밖으로 공유할 공개 웹 주소(예: https://your-bellama-domain.example). 비우면 네이티브 앱은 VITE_API_ORIGIN을 사용합니다.
# VITE_PUBLIC_ORIGIN=
# 앱 화면의 출처(기본: capacitor://localhost, https://localhost / 개발에서만 http://localhost). 더 필요하면 쉼표로 추가.
# APP_CLIENT_ORIGINS=
# 앱 영상 주소용 미디어 토큰 서명 비밀값(비우면 DB에 한 번 만들어 저장하고 모든 서버가 함께 씀).
# MEDIA_TOKEN_SECRET=
# 테스트 전용: PostgreSQL로 테스트할 때 관리자 접속 주소(npm run test:pg)
# TEST_PG_ADMIN_URL=postgres://user:pass@127.0.0.1:5432/postgres
